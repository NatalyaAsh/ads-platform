# gRPC сервер
GRPC_PORT=50052
GRPC_READ_TIMEOUT=10s
GRPC_WRITE_TIMEOUT=10s
GRPC_MAX_CONNECTIONS=100

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ad_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ad_media

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Логи
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT_PATH=stdout

# Сервис
SERVICE_NAME=ad-search-service
ENV=dev
SERVICE_VERSION=1.0.0