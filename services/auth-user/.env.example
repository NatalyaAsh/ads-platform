# Сервер
GRPC_PORT=50051
GRPC_READ_TIMEOUT=10s
GRPC_WRITE_TIMEOUT=10s
GRPC_MAX_CONNECTIONS=100

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_user_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-2024
JWT_REFRESH_SECRET=your-super-secret-refresh-key-2024
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_ISSUER=auth-service

# Логи
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT_PATH=stdout

# Настройки сервиса
SERVICE_NAME=auth-user-service
ENV=dev
ENVIRONMENT=dev
SERVICE_VERSION=1.0.0
ENABLE_TLS=false
TLS_CERT_FILE=
TLS_KEY_FILE=